#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>

&mt {
    tapping-term-ms = <120>;
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_boot_dongle {
            timeout-ms = <50>;
            key-positions = <0 5 38 6 11 39>;
            bindings = <&bootloader>;
        };

        combo_boot_left {
            timeout-ms = <50>;
            key-positions = <0 5 38>;
            bindings = <&sl 5>;
        };

        combo_boot_right {
            timeout-ms = <50>;
            key-positions = <6 11 39>;
            bindings = <&sl 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I     &kp O   &kp P       &kp BSPC
                &kp TAB   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI    &kp BSLH
                &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH    &kp SQT
                        &kp LGUI &mo 2 &mt LSHIFT ENTER &kp SPACE &mo 1  &kp RALT
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
                &kp GRAVE &kp TILDE &trans    &kp FSLH &kp ASTERISK &trans   &trans    &kp LBKT &kp RBKT &trans &trans &trans
                &kp TAB   &kp LALT  &kp MINUS &kp PLUS &kp EQUAL    &trans   &kp UNDER &kp LBRC &kp RBRC &trans &trans &trans
                &trans &trans &trans &trans &trans &trans                    &trans    &kp LPAR &kp RPAR &trans &trans &trans
                                     &trans &mo 3 &kp LS(ENTER)                &trans &trans &trans 
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
                &trans &trans &kp DEL  &kp UP   &kp PSCRN &trans   &kp N7 &kp N8 &kp N9 &trans &trans &trans
                &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans   &kp N4 &kp N5 &kp N6 &trans &trans &trans
                &trans &trans &trans   &trans   &trans    &trans   &kp N1 &kp N2 &kp N3 &trans &trans &trans
                                       &trans   &trans    &trans   &trans &mo 3 &kp N0
            >;
        };

        functions {
            display-name = "Functions";
            bindings = <
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        blank {
            display-name = "Blank";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };

        boot {
            display-name = "Boot";
            bindings = <
                &trans &bootloader &trans &trans &trans &trans   &trans &trans &trans &trans &bootloader &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};