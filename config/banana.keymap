#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>

#include "helpers.h"

#define DEF 0
#define SYM 1
#define NUM 2
#define FUN 3
#define RES 4
#define BOOT 5

#define ___ &trans

&mt {
    tapping-term-ms = <120>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_boot_dongle {
            timeout-ms = <50>;
            key-positions = <LT0 LT5 LH0 RT0 RT5 RH0>;
            bindings = <&bootloader>;
        };

        combo_boot_left {
            timeout-ms = <50>;
            key-positions = <LT0 LT5 LH0>;
            bindings = <&sl BOOT>;
        };

        combo_boot_right {
            timeout-ms = <50>;
            key-positions = <RT0 RT5 RH0>;
            bindings = <&sl BOOT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer  {
            if-layers = <SYM NUM>;
            then-layer = <FUN>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <

// ╭──────────┬─────────────┬─────────────┬──────────────┬───────────────┬──────────────────╮      ╭───────────┬───────────────┬──────────────┬─────────────┬────────────────┬──────────╮
     &kp ESC    &kp Q         &kp W         &kp E          &kp R           &kp T                     &kp Y       &kp U           &kp I          &kp O         &kp P            &kp BSPC
// ├──────────┼─────────────┼─────────────┼──────────────┼───────────────┼──────────────────┤      ├───────────┼───────────────┼──────────────┼─────────────┼────────────────┼──────────┤
     &kp TAB    &hml LALT A   &hml LGUI S   &hml LCTRL D   &hml LSHIFT F   &kp G                     &kp H       &hmr RSHIFT J   &hmr RCTRL K   &hmr RGUI L   &hmr RALT SEMI   &kp BSLH
// ├──────────┼─────────────┼─────────────┼──────────────┼───────────────┼──────────────────┤      ├───────────┼───────────────┼──────────────┼─────────────┼────────────────┼──────────┤
     &kp LCTRL  &kp Z         &kp X         &kp C          &kp V           &kp B                     &kp N       &kp M           &kp COMMA      &kp DOT       &kp FSLH         &kp SQT
// ╰──────────┴─────────────┴─────────────┼──────────────┼───────────────┼──────────────────┤      ├───────────┼───────────────┼──────────────┼─────────────┴────────────────┴──────────╯
                                            &kp LGUI       &mo NUM         &mt LSHIFT ENTER          &kp SPACE   &mo SYM         &kp LGUI
//                                        ╰──────────────┴───────────────┴──────────────────╯      ╰───────────┴───────────────┴──────────────╯


            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
// ╭───────────┬───────────┬─────────────────┬─────────────────┬───────────────────┬───────────────╮      ╭───────────┬──────────────────┬─────────────────┬──────────┬──────────┬──────────╮
     &kp GRAVE   &kp TILDE   ___               &kp FSLH          &kp ASTERISK        ___                    ___         &kp LBKT           &kp RBKT          ___        ___        ___
// ├───────────┼───────────┼─────────────────┼─────────────────┼───────────────────┼───────────────┤      ├───────────┼──────────────────┼─────────────────┼──────────┼──────────┼──────────┤
     &kp TAB     &kp LALT    &hml LGUI MINUS   &hml LCTRL PLUS   &hml LSHIFT EQUAL   ___                    &kp UNDER   &hmr RSHIFT LBRC   &hmr RCTRL RBRC   &kp RGUI   &kp RALT   ___
// ├───────────┼───────────┼─────────────────┼─────────────────┼───────────────────┼───────────────┤      ├───────────┼──────────────────┼─────────────────┼──────────┼──────────┼──────────┤
     ___         ___         ___               ___               ___                 ___                    ___         &kp LPAR           &kp RPAR          ___        ___        ___
// ╰───────────┴───────────┴─────────────────┼─────────────────┼───────────────────┼───────────────┤      ├───────────┼──────────────────┼─────────────────┼──────────┴──────────┴──────────╯
                                               ___               ___                 &kp LS(ENTER)          ___         ___                ___ 
//                                           ╰─────────────────┴───────────────────┴───────────────╯      ╰───────────┴──────────────────┴─────────────────╯
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
// ╭───────────┬───────────┬────────────────┬─────────────────┬───────────────────┬───────────╮      ╭───────────┬────────────────┬────────────────┬──────────┬──────────┬──────────╮
     ___         ___         &kp DEL          &kp UP            &kp PSCRN           ___                &kp N7      &kp N8           &kp N9           ___        ___        ___
// ├───────────┼───────────┼────────────────┼─────────────────┼───────────────────┼───────────┤      ├───────────┼────────────────┼────────────────┼──────────┼──────────┼──────────┤
     ___         &kp LALT    &hml LGUI LEFT   &hml LCTRL DOWN   &hml LSHIFT RIGHT   ___                &kp N4      &hmr RSHIFT N5   &hmr RCTRL N6    &kp RGUI   &kp RALT   ___
// ├───────────┼───────────┼────────────────┼─────────────────┼───────────────────┼───────────┤      ├───────────┼────────────────┼────────────────┼──────────┼──────────┼──────────┤
     ___         ___         ___              ___               ___                 ___                &kp N1      &kp N2           &kp N3           ___        ___        ___
// ╰───────────┴───────────┴────────────────┼─────────────────┼───────────────────┼───────────┤      ├───────────┼────────────────┼────────────────┼──────────┴──────────┴──────────╯
                                              ___               ___                 ___                ___         ___              &kp N0 
//                                          ╰─────────────────┴───────────────────┴───────────╯      ╰───────────┴────────────────┴────────────────╯
            >;
        };

        functions {
            display-name = "Functions";
            bindings = <
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮      ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
     ___         &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT          &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     ___         &kp LALT    &kp LGUI    &kp LCTRL   &kp LSHIFT  ___                ___         &kp RSHIFT  &kp RCTRL   &kp RGUI    &kp RALT     ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6             &kp F7      &kp F8      &kp F9      &kp F10     &kp F11     &kp F12
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                         ___         ___         ___                ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯      ╰───────────┴───────────┴───────────╯

            >;
        };

        blank {
            display-name = "Blank";
            bindings = <
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮      ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
     ___         ___         ___         ___         ___         ___                ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     ___         &kp LALT    &kp LGUI   &kp LCTRL   &kp LSHIFT   ___                ___         &kp RSHIFT   &kp RCTRL   &kp RGUI   &kp RALT   ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
     ___         ___         ___         ___         ___         ___                ___         ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┤───────────┤      ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                         ___         ___         ___                ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯      ╰───────────┴───────────┴───────────╯

            >;
        };

        boot {
            display-name = "Boot";
            bindings = <
// ╭───────────┬─────────────┬───────────┬───────────┬───────────┬───────────╮      ╭───────────┬───────────┬───────────┬───────────┬─────────────┬───────────╮
     ___         &bootloader   ___         ___         ___         ___                ___         ___         ___         ___         &bootloader   ___
// ├───────────┼─────────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼─────────────┼───────────┤
     ___         &kp LALT      &kp LGUI    &kp LCTRL    &kp LSHIFT    ___                ___         &kp RSHIFT  &kp RCTRL   &kp RGUI    &kp RALT     ___
// ├───────────┼─────────────┼───────────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────┼─────────────┼───────────┤
     ___         ___           ___         ___         ___         ___                ___         ___         ___         ___         ___           ___
// ╰───────────┴─────────────┴───────────┼───────────┼───────────┤───────────┤      ├───────────┼───────────┼───────────┼───────────┴─────────────┴───────────╯
                                           ___         ___         ___                ___         ___         ___
//                                       ╰───────────┴───────────┴───────────╯      ╰───────────┴───────────┴───────────╯
            >;
        };
    };
};